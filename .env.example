# Copy to .env and fill in the values. Never commit .env (it is gitignored).
# Restful-Booker documents its admin credentials at https://restful-booker.herokuapp.com/apidoc/index.html
#
# Local Docker instance (docker compose up -d --wait):
BASE_URL=http://localhost:3001
# Public instance (shared, data changes constantly):
# BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=<admin username>
BOOKER_PASSWORD=<admin password>
